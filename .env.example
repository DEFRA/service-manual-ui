ENABLE_AI_CONTENT=true
AI_TOOLKIT_ALLOWED_EMAIL_DOMAINS="defra.gov.uk,example.com"
AI_TOOLKIT_NOTIFY_KEY="dummy_key"
AI_TOOLKIT_TRIAGE_TEMPLATE_ID="dummy_template_id"
AI_TOOLKIT_CONFIRMATION_TEMPLATE_ID="dummy_confirmation_template_id"
AICE_SHARED_MAILBOX_EMAIL="ai@example.com"
# Posting triage submissions on to the aice-triage-automation backend. Off by
# default; the backend runs on port 3001 on a laptop.
AI_TRIAGE_BACKEND_ENABLED=false
AI_TRIAGE_BACKEND_URL="http://localhost:3001"
# Off locally: the AWS token service does not implement GetWebIdentityToken in
# localstack, so no token is requested and the post carries no header.
AI_TRIAGE_AUTH_ENABLED=false
SESSION_COOKIE_PASSWORD="dummy-session-cookie-password-12"
