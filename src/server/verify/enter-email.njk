{% extends "layouts/page.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}

{% block beforeContent %}
  {{ govukBackLink({
    text: "Back",
    href: "/"
  }) }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
    <div class="govuk-error-summary" data-module="govuk-error-summary">
      <div role="alert">
        <h2 class="govuk-error-summary__title">There is a problem</h2>
        <div class="govuk-error-summary__body">
          <ul class="govuk-list govuk-error-summary__list">
            <li><a href="#email">{{ error }}</a></li>
          </ul>
        </div>
      </div>
    </div>
    {% endif %}

    <h1 class="govuk-heading-xl">Verify your email address</h1>
    <p class="govuk-body">Before you can continue, we need to verify your email address. We will send you a verification code.</p>

    <form method="post" action="/verify">
      <input type="hidden" name="returnUrl" value="{{ returnUrl }}">

      <div class="govuk-form-group{% if error %} govuk-form-group--error{% endif %}">
        <label class="govuk-label" for="email">Email address</label>
        {% if error %}
        <p id="email-error" class="govuk-error-message">
          <span class="govuk-visually-hidden">Error:</span> {{ error }}
        </p>
        {% endif %}
        <input
          class="govuk-input{% if error %} govuk-input--error{% endif %}"
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          spellcheck="false"
          value="{{ email or '' }}"
          aria-describedby="{% if error %}email-error{% endif %}">
      </div>

      <button type="submit" class="govuk-button" data-module="govuk-button">Continue</button>
    </form>

  </div>
</div>
{% endblock %}
