{% extends "layouts/page.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

{% block pageTitle %}{{ pageTitle }} | {{ headerServiceName }}{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: 'Ask the toolkit is experimental. <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk?subject=Ask%20the%20toolkit%3A%20feedback">Give feedback</a> to help us improve it.'
  }) }}
  {{ super() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-xl">Contact the team</h1>

    <p class="govuk-body-l">Your email opens in your own mail app, so you can read it and change it before it goes.</p>

    <p class="govuk-body">
      <a class="govuk-button app-ask__send" href="{{ contactHref }}" data-module="govuk-button" role="button" draggable="false">
        Open your email
      </a>
    </p>

    {# Nothing here can tell whether the email was actually sent, so this says
       what the team does with one when it arrives rather than claiming
       anything was received. The five working days matches the triage
       thank-you page, so the two routes to the team promise the same thing. #}
    <h2 class="govuk-heading-m">What happens next</h2>
    <p class="govuk-body">A member of the AI Capability and Enablement team reads your email and replies within five working days. They may:</p>
    <ul class="govuk-list govuk-list--bullet">
      <li>answer your question directly</li>
      <li>point you at guidance the toolkit did not find</li>
      <li>offer a session with one of their practitioners</li>
    </ul>
    <p class="govuk-body">You do not need to wait for a reply to <a class="govuk-link" href="/ai-toolkit">carry on using the toolkit</a>.</p>

    {% if conversationRequested and not conversationIncluded %}
    <h2 class="govuk-heading-m">Your conversation is too long to add automatically</h2>
    <p class="govuk-body">An email link can only carry a limited amount of text, and this conversation is over that limit. Nothing has been lost. Copy the text below and paste it into your email after it opens.</p>
    {% elif conversationIncluded %}
    <h2 class="govuk-heading-m">What is in the email</h2>
    <p class="govuk-body">Your questions and answers are included, exactly as below.</p>
    {% else %}
    <h2 class="govuk-heading-m">Your conversation</h2>
    <p class="govuk-body">This is not in the email. Copy it in if you want the team to see it.</p>
    {% endif %}

    {# Not pre or code. This is prose with line breaks, and code markup makes
       some screen readers announce it as code. The wrapping is done in CSS. #}
    <div class="app-ask__transcript govuk-body">{{ transcript }}</div>

    <p class="govuk-body">
      <a class="govuk-link" href="{{ backHref }}">Back to your answer</a>
    </p>

  </div>
</div>
{% endblock %}
