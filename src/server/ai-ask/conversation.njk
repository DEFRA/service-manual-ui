{% extends "layouts/page.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block pageTitle %}
  {%- if error %}Error: {% endif -%}
  {{ pageTitle | truncate(60) }} | {{ headerServiceName }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: 'This is a new service. <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk?subject=Ask%20the%20toolkit%3A%20feedback">Give feedback</a> to help us improve it.'
  }) }}
  {{ super() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-three-quarters">

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [{ text: error, href: "#question" }]
      }) }}
    {% endif %}

    {# The question just asked heads the page. It is what makes this page
       different from the last one, and it is what orients someone arriving
       here, in the same way a search results page leads with the search. #}
    <span class="govuk-caption-l">You asked</span>
    <h1 class="govuk-heading-l app-ask__question-heading">{{ latest.question }}</h1>

    {% set answer = latest.answer %}
    {% include "partials/ask-answer.njk" %}

    {# The next question sits directly under the answer it follows on from,
       not at the foot of a page that grows with every question asked. #}
    {% include "partials/ask-question-form.njk" %}

    {% if previous | length %}
    <details class="govuk-details app-ask__previous">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">
          {% if previous | length == 1 %}1 earlier question{% else %}{{ previous | length }} earlier questions{% endif %}
        </span>
      </summary>
      <div class="govuk-details__text">
        {% for exchange in previous %}
        <div class="app-ask__earlier">
          <span class="govuk-caption-m">You asked</span>
          <h2 class="govuk-heading-s">{{ exchange.question }}</h2>
          {% set answer = exchange.answer %}
          {% include "partials/ask-answer.njk" %}
        </div>
        {% endfor %}
      </div>
    </details>
    {% endif %}

    <div class="defra-support-box">
      <h2 class="govuk-heading-m">Are you stuck?</h2>
      <p class="govuk-body">If this has not got you what you need, contact the AI Capability and Enablement team.</p>
      <form method="post" action="/ai-toolkit/ask/stuck">
        <div class="govuk-form-group">
          <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="include-conversation" name="includeConversation" type="checkbox" value="yes">
              <label class="govuk-label govuk-checkboxes__label" for="include-conversation">
                Send my questions and answers too, so the team can see what I tried
              </label>
            </div>
          </div>
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
          Contact the team
        </button>
      </form>
    </div>

    <p class="govuk-body">
      <a class="govuk-link" href="/ai-toolkit/ask/restart">Start a new conversation</a>
    </p>

  </div>
</div>
{% endblock %}
