{% extends "layouts/page.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{% block pageTitle %}
  {%- if error %}Error: {% endif -%}
  {{ pageTitle }} | {{ headerServiceName }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: 'This is a new service. <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk?subject=Ask%20the%20toolkit">Give feedback</a> to help us improve it.'
  }) }}
  {{ super() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [{ text: error, href: "#question" }]
      }) }}
    {% endif %}

    <h1 class="govuk-visually-hidden">Your questions and answers</h1>

    <ol class="govuk-list app-ask__messages">
      {% for message in messages %}
      {% if message.type == 'question' %}
      <li class="app-ask__message">
        <p class="app-ask__message-from">You</p>
        <div class="app-ask__question">{{ message.text }}</div>
      </li>
      {% else %}
      <li class="app-ask__message">
        <p class="app-ask__message-from">
          Ask the toolkit
          <strong class="govuk-tag govuk-tag--grey app-ask__tag">AI-generated</strong>
        </p>
        <div class="app-ask__answer">

          {% if message.answer.message %}
          <p class="govuk-body">{{ message.answer.message }}</p>
          {% endif %}

          {% if message.answer.rule %}
          <blockquote class="app-ask__rule">
            <p class="app-ask__rule-label">Quoted from the guidance, word for word</p>
            <p class="app-ask__rule-text govuk-body">{{ message.answer.rule.text }}</p>
            <p class="app-ask__rule-source">
              <a class="govuk-link" href="{{ message.answer.rule.source.url }}">{{ message.answer.rule.source.title }}</a>{% if message.answer.rule.source.section %}, {{ message.answer.rule.source.section }}{% endif %}
            </p>
          </blockquote>
          {% endif %}

          {% if message.answer.sources | length %}
          <h2 class="govuk-heading-s">Check this answer</h2>
          <ul class="govuk-list app-ask__sources">
            {% for source in message.answer.sources %}
            <li>
              <a class="govuk-link" href="{{ source.url }}">{{ source.title }}</a>
              {% if source.section %}<span class="app-ask__source-section">{{ source.section }}</span>{% endif %}
            </li>
            {% endfor %}
          </ul>
          {% endif %}

        </div>
      </li>
      {% endif %}
      {% endfor %}
    </ol>

    {% include "partials/ask-question-form.njk" %}

    <div class="defra-callout app-ask__stuck">
      <h2 class="govuk-heading-m">Are you stuck?</h2>
      <p class="govuk-body">If the answers have not got you what you need, contact the AI Capability and Enablement team.</p>
      <form method="post" action="/ai-toolkit/ask/stuck">
        <div class="govuk-form-group">
          <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
            <div class="govuk-checkboxes__item">
              <input class="govuk-checkboxes__input" id="include-conversation" name="includeConversation" type="checkbox" value="yes">
              <label class="govuk-label govuk-checkboxes__label" for="include-conversation">
                Send my questions and answers too, so the team can see what I tried
              </label>
            </div>
          </div>
        </div>
        <button type="submit" class="govuk-button govuk-button--secondary" data-module="govuk-button">
          Contact the team
        </button>
      </form>
    </div>

    <p class="govuk-body">
      <a class="govuk-link" href="/ai-toolkit/ask/restart">Start a new conversation</a>
    </p>

  </div>
</div>
{% endblock %}
