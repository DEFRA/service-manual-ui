{% extends "layouts/page.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}

{# The tab carries the question, cut short, so history and open tabs stay
   distinguishable. The heading on the page does not, because a question can
   run to 500 characters and a heading that can become a paragraph is not a
   heading. #}
{% block pageTitle %}
  {%- if error %}Error: {% endif -%}
  {{ pageTitle | truncate(60) }} | {{ headerServiceName }}
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: 'This is a new service. <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk?subject=Ask%20the%20toolkit%3A%20feedback">Give feedback</a> to help us improve it.'
  }) }}
  {{ super() }}
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-three-quarters">

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [{ text: error, href: "#question" }]
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l">Your answer</h1>

    {# The question sits at body size, where a long one wraps harmlessly. #}
    <div class="app-ask__asked">
      <span class="app-ask__asked-label">You asked</span>
      <p class="govuk-body app-ask__asked-text">{{ latest.question }}</p>
    </div>

    {% set answer = latest.answer %}
    {% set sourcesHeadingLevel = 2 %}
    {% include "partials/ask-answer.njk" %}

    {# The next question sits directly under the answer it follows on from,
       not at the foot of a page that grows with every question asked. #}
    {% include "partials/ask-question-form.njk" %}

    <details class="govuk-details app-ask__support">
      <summary class="govuk-details__summary">
        <span class="govuk-details__summary-text">Do you need to speak to someone?</span>
      </summary>
      <div class="govuk-details__text">
        <p class="govuk-body">If this has not got you what you need, contact the AI Capability and Enablement team.</p>
        <form method="post" action="/ai-toolkit/ask/stuck">
          <div class="govuk-form-group">
            <div class="govuk-checkboxes govuk-checkboxes--small" data-module="govuk-checkboxes">
              <div class="govuk-checkboxes__item">
                <input class="govuk-checkboxes__input" id="include-conversation" name="includeConversation" type="checkbox" value="yes">
                <label class="govuk-label govuk-checkboxes__label" for="include-conversation">
                  Send my questions and answers too, so the team can see what I tried
                </label>
              </div>
            </div>
          </div>
          <button type="submit" class="govuk-button govuk-button--secondary govuk-!-margin-bottom-0" data-module="govuk-button">
            Contact the team
          </button>
        </form>
      </div>
    </details>

    {% if previous | length %}
    {# One row per question, not one disclosure holding everything. At twenty
       questions a single disclosure opens onto a wall with nothing to scan;
       a list of questions stays a list of questions however long it gets. #}
    <h2 class="govuk-heading-m app-ask__earlier-heading">Earlier questions</h2>
    <ul class="govuk-list app-ask__earlier-list">
      {% for exchange in previous %}
      <li>
        <details class="govuk-details app-ask__earlier">
          <summary class="govuk-details__summary">
            <span class="govuk-details__summary-text">{{ exchange.question }}</span>
          </summary>
          <div class="govuk-details__text">
            {% set answer = exchange.answer %}
            {% set sourcesHeadingLevel = 3 %}
            {% include "partials/ask-answer.njk" %}
          </div>
        </details>
      </li>
      {% endfor %}
    </ul>
    {% endif %}

    <p class="govuk-body">
      <a class="govuk-link" href="/ai-toolkit/ask/restart">Start a new conversation</a>
    </p>

  </div>
</div>
{% endblock %}
