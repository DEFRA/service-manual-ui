{% extends "layouts/page.njk" %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/notification-banner/macro.njk" import govukNotificationBanner %}

{# The tab shows the question's position in the conversation, never the
   question: analytics records page titles, and nothing someone typed should
   leave the service. #}
{% block pageTitle %}
  {%- if error or serviceProblem %}Error: {% endif -%}
  {{ pageTitle }} | {{ headerServiceName }}
{% endblock %}

{% block beforeContent %}
  {% include "partials/ask-phase-banner.njk" %}
  {# super() is not called: it renders breadcrumbs, and the Design System says
     never to show a back link and breadcrumbs together. #}
  <a href="{{ backLink.href }}" class="govuk-back-link">{{ backLink.text }}</a>
{% endblock %}

{% block content %}
{# Three quarters, the same width as the question box on the front door. Not
   full width: a line there runs to about 120 characters, well past the 75 or
   so that reads easily. #}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-three-quarters">

    {% if reported %}
      {{ govukNotificationBanner({
        type: "success",
        html: '<p class="govuk-notification-banner__heading">Report sent</p><p class="govuk-body">The AI Capability and Enablement team has your report on answer ' + reported + '. Thank you.</p>'
      }) }}
    {% endif %}

    {# A failure on our side is not a mistake in the question, so it is a
       summary with no field to fix. #}
    {% if serviceProblem %}
      {{ govukErrorSummary({
        titleText: "Sorry, there is a problem with the service",
        descriptionText: serviceProblem
      }) }}
    {% endif %}

    {% if error %}
      {{ govukErrorSummary({
        titleText: "There is a problem",
        errorList: [{ text: error, href: "#question" }]
      }) }}
    {% endif %}

    <h1 class="govuk-heading-l app-ask__title">Ask the toolkit</h1>

    {% if hiddenCount %}
    <p class="govuk-body app-ask__earlier">
      <a class="govuk-link" href="{{ showEarlierHref }}">Show {{ hiddenCount }} earlier question{% if hiddenCount != 1 %}s{% endif %}</a>
    </p>
    {% endif %}

    {# Each turn is named by a heading as well as set apart by position and
       shape, so a screen reader user can move from turn to turn and nobody
       has to rely on layout to tell who said what. #}
    {% for turn in turns %}
    <div class="app-ask__turn" id="turn-{{ turn.number }}">
      <div class="app-ask__asked">
        <h2 class="app-ask__speaker" tabindex="-1">You<span class="govuk-visually-hidden">, question {{ turn.number }}</span></h2>
        <p class="govuk-body app-ask__asked-text">{{ turn.question }}</p>
      </div>

      {% set answer = turn.answer %}
      {% set answerNumber = turn.number %}
      {% set isLatestTurn = turn.isLatest %}
      {% set canFollowUp = turn.isLatest and canContinue %}
      {% include "partials/ask-answer.njk" %}

      {% if turn.reported %}
      <p class="govuk-body-s app-ask__report">Report sent<span class="govuk-visually-hidden"> for answer {{ turn.number }}</span></p>
      {% elif turn.reportHref %}
      <p class="govuk-body-s app-ask__report"><a class="govuk-link" href="{{ turn.reportHref }}">Report a problem with this answer<span class="govuk-visually-hidden"> (answer {{ turn.number }})</span></a></p>
      {% endif %}
    </div>
    {% endfor %}

    {% if canContinue %}
      {% include "partials/ask-question-form.njk" %}
      {# The way to start over sits where the decision is made: at the field,
         when someone realises the next question is not a follow-up. A plain
         sentence rather than hint text, because the Design System says not
         to put links in hint text. #}
      <p class="govuk-body app-ask__restart">Asking about something else? <a class="govuk-link" href="{{ paths.restart }}">Start a new conversation</a></p>
    {% else %}
      <p class="govuk-body">This conversation has reached {{ maxExchanges }} questions, which is as long as one can be. <a class="govuk-link" href="{{ paths.restart }}">Start a new conversation</a> to keep asking.</p>
    {% endif %}

    {# The same support box as every other toolkit page, so the route to a
       person is where people already look for it. #}
    {% include "partials/support-box.njk" %}

  </div>
</div>
{% endblock %}
