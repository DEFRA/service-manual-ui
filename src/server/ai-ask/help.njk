{% extends "layouts/page.njk" %}

{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

{% block pageTitle %}{{ pageTitle }} | {{ headerServiceName }}{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Beta" },
    html: 'Ask the toolkit is experimental. <a class="govuk-link" href="mailto:AICapabilityAndEnablement@defra.gov.uk?subject=Ask%20the%20toolkit%3A%20feedback">Give feedback</a> to help us improve it.'
  }) }}
  <a href="{{ backHref }}" class="govuk-back-link">Back to your answer</a>
{% endblock %}

{% block content %}
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">

    <h1 class="govuk-heading-l">Speak to someone</h1>

    <p class="govuk-body-l">The AI Capability and Enablement team can advise on your own project, or anything that needs a decision.</p>

    <form method="post" action="/ai-toolkit/ask/stuck">
      <div class="govuk-form-group">
        <div class="govuk-checkboxes" data-module="govuk-checkboxes">
          <div class="govuk-checkboxes__item">
            <input class="govuk-checkboxes__input" id="include-conversation" name="includeConversation" type="checkbox" value="yes">
            <label class="govuk-label govuk-checkboxes__label" for="include-conversation">
              Send my questions and answers too, so the team can see what I tried
            </label>
          </div>
        </div>
      </div>

      <button type="submit" class="govuk-button app-ask__send" data-module="govuk-button">
        Continue
      </button>
    </form>

  </div>
</div>
{% endblock %}
