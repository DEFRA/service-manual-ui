{# One answer: what the toolkit said, the rule it quoted if it quoted one,
   the guidance to check it against, and the reminder that it can be wrong.

   cannot_answer, talk_to_a_person and blocked each get a short block of
   their own below the message, in place of content built for an answer that
   isn't there: a rule, or a "check this answer" list with nothing behind
   it. The wording in those blocks is a stub that will be replaced (card
   012); the one rule already agreed is that blocked never says the question
   was flagged, filtered, unsafe or violated anything. #}

{% from "govuk/components/radios/macro.njk" import govukRadios %}
{% from "govuk/components/button/macro.njk" import govukButton %}
<div class="app-ask__answer">

  {% if answer.status == 'answered' or answer.status == 'need_more_detail' %}
  <span class="app-ask__eyebrow">Toolkit answer</span>
  {% endif %}

  {% if answer.status == 'cannot_answer' %}
    {% if answer.reason == 'no_guidance_yet' %}
    <p class="govuk-body">The toolkit does not cover this yet. The closest guidance is below.</p>
    {% else %}
    <p class="govuk-body">The toolkit covers choosing a tool, the data you can use with it, and the patterns other teams have built. <a class="govuk-link" href="{{ paths.toolkit }}">Go to the AI digital toolkit</a></p>
    {% endif %}
  {% endif %}

  {% if answer.status == 'talk_to_a_person' %}
  <p class="app-ask__contact-link">
    {{ govukButton({ href: paths.help, text: "Speak to the team" }) }}
  </p>
  {% endif %}

  {% if canFollowUp and answer.status == 'need_more_detail' and answer.options | length %}
  {# The options narrow the question, so choosing one posts it as the next
     question through the same route the free-text follow-up box below
     uses. No script, no new endpoint: a form and a name the controller
     already reads. Gated on canFollowUp, same as the free-text box below:
     an earlier answer page or a conversation at its limit must not offer a
     control the POST handler will refuse. #}
  <form method="post" action="{{ paths.ask }}" novalidate class="app-ask__options">
    {{ govukRadios({
      idPrefix: "option",
      name: "question",
      fieldset: {
        legend: {
          text: "Choose an option",
          classes: "govuk-visually-hidden"
        }
      },
      errorMessage: { text: optionsError } if optionsError else null,
      items: answer.options | toRadioItems
    }) }}
    {# name/value here, not on the free-text button, is how the controller
       tells an empty options submission apart from an empty free-text one:
       the same POST route serves both forms, and only one can point the
       error back at the field that was actually used. #}
    <button type="submit" name="from" value="options" class="govuk-button app-ask__send" data-module="govuk-button">
      Continue
    </button>
  </form>
  {% endif %}

  {% if answer.rule %}
  <blockquote class="app-ask__rule">
    <p class="app-ask__rule-label">Quoted from the guidance, word for word</p>
    <p class="app-ask__rule-text govuk-body">{{ answer.rule.text }}</p>
    <p class="app-ask__rule-source">
      From <a class="govuk-link" href="{{ answer.rule.source.url }}">{{ answer.rule.source.title }}</a>
    </p>
  </blockquote>
  {% endif %}

  {% if answer.sources | length %}
  <div class="app-ask__check">
    {# cannot_answer's sources are the nearest guidance found, not something
       to check an answer against, since there isn't one. #}
    <h2 class="govuk-heading-s app-ask__check-heading">{{ "Nearest guidance" if answer.status == 'cannot_answer' else "Check this answer" }}</h2>
    {# Page titles only. The section came through as a subtitle like "What the
       conditions mean", which reads as a stray fragment next to a page name
       and told nobody anything. The API still carries it, and the right use
       for it is a link straight to that part of the page rather than a label.
       #}
    <ul class="govuk-list govuk-list--bullet app-ask__sources">
      {% for source in answer.sources %}
      <li>
        <a class="govuk-link" href="{{ source.url }}">{{ source.title }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Last, under the guidance it used, so the warning is the final word before
     someone acts on the answer. #}
  {% set warningText = "AI can make mistakes. Check the guidance before you act." %}
  {% set warningClass = "" %}
  {% include "partials/ask-warning.njk" %}

</div>
