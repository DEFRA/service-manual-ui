{# One answer. Used for the answer leading the page and for each one folded
   away under earlier questions, so the two can never drift apart.

   sourcesHeadingLevel is 2 under the page heading and 3 inside an earlier
   question, where the question itself is the heading above it. #}
<div class="app-ask__answer">

  <span class="app-ask__eyebrow">Toolkit answer</span>

  {% if answer.message %}
  <p class="govuk-body">{{ answer.message }}</p>
  {% endif %}

  {% if answer.rule %}
  <blockquote class="app-ask__rule">
    <p class="app-ask__rule-label">Quoted from the guidance, word for word</p>
    <p class="app-ask__rule-text govuk-body">{{ answer.rule.text }}</p>
    <p class="app-ask__rule-source">
      <a class="govuk-link" href="{{ answer.rule.source.url }}">{{ answer.rule.source.title }}</a>{% if answer.rule.source.section %}, {{ answer.rule.source.section }}{% endif %}
    </p>
  </blockquote>
  {% endif %}

  {% if answer.sources | length %}
  <div class="app-ask__check">
    {% if sourcesHeadingLevel == 3 %}
    <h3 class="govuk-heading-s app-ask__check-heading">Check this answer</h3>
    {% else %}
    <h2 class="govuk-heading-s app-ask__check-heading">Check this answer</h2>
    {% endif %}
    {# The section is part of the link text rather than a line under it. Only
       some sources have one, so a separate subtitle left most entries with a
       dangling gap. This is how GOV.UK Chat writes the same thing. #}
    <ul class="govuk-list govuk-list--bullet app-ask__sources">
      {% for source in answer.sources %}
      <li>
        <a class="govuk-link" href="{{ source.url }}">{{ source.title }}{% if source.section %}: {{ source.section }}{% endif %}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Last, under the guidance it used, so the warning is the final word before
     someone acts on the answer. #}
  <p class="app-ask__warning">
    <svg class="app-ask__warning-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
      <circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M10 5v6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <circle cx="10" cy="14.5" r="1.25" fill="currentColor"/>
    </svg>
    <strong>Ask the toolkit can make mistakes. Check the guidance before you act on this.</strong>
  </p>

</div>
