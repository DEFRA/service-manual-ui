{# One reply from the toolkit: what it said, the rule it quoted if it quoted
   one, the guidance it used, and, where there is an answer to act on, the
   reminder that it can be wrong.

   Set answer, answerNumber, isLatestTurn and canFollowUp before including.
   canFollowUp is true only on the newest turn of a conversation that is not
   full; isLatestTurn is true on the newest turn whether or not it is full.

   cannot_answer and talk_to_a_person open with a line that says what
   happened, before anything else. blocked never says the question was
   flagged, filtered, unsafe or violated anything. #}
<div class="app-ask__answer">

  {# Every reply is named, whatever its outcome, so screen reader users can
     find each one by heading. #}
  <h2 class="app-ask__speaker">AI toolkit<span class="govuk-visually-hidden">, answer {{ answerNumber }}</span></h2>

  {% if answer.status == 'talk_to_a_person' %}
  <p class="govuk-body app-ask__outcome">This one is for the team.</p>
  {% endif %}

  {% if answer.status == 'cannot_answer' %}
    {% if answer.reason == 'no_guidance_yet' %}
    <p class="govuk-body">The toolkit does not cover this yet. The closest guidance is below.</p>
    {% else %}
    <p class="govuk-body">The toolkit cannot answer this. It covers choosing a tool, the data you can use with it, and the patterns other teams have built. <a class="govuk-link" href="{{ paths.toolkit }}">Go to the AI digital toolkit</a></p>
    {% endif %}
  {% endif %}

  {# cannot_answer already has its own fixed wording above, in place of the
     model's message, so this hides it there. talk_to_a_person still shows its
     message: that's where the model says why the team is the right place and
     what to bring. #}
  {% if answer.message and answer.status != 'cannot_answer' %}
  <p class="govuk-body">{{ answer.message }}</p>
  {% endif %}

  {# The route to a person, on the newest turn only: an older reply should
     not keep asking you to email. Not tied to whether you can still ask: a
     full conversation that ends on "this one is for the team" still needs
     the way to the team. #}
  {% if answer.status == 'talk_to_a_person' and isLatestTurn %}
  <p class="govuk-body"><a class="govuk-link" href="{{ paths.help }}">Email the AI Capability and Enablement team</a></p>
  {% endif %}

  {% if canFollowUp and answer.status == 'need_more_detail' and answer.options | length %}
  {# Quick replies: each option sends itself as the next question in one
     press, through the same route as the question box. Grey buttons, so none
     competes with the one green button on the page. The group is named, so a
     screen reader announces what the choices are for. #}
  <form method="post" action="{{ paths.ask }}" class="app-ask__quick-replies" role="group" aria-labelledby="quick-replies-{{ answerNumber }}" data-ask-quick-replies>
    <p class="govuk-body-s app-ask__quick-replies-label" id="quick-replies-{{ answerNumber }}">Choose one, or ask your own question.</p>
    <div class="govuk-button-group">
      {% for option in answer.options %}
      <button type="submit" name="question" value="{{ option }}" class="govuk-button govuk-button--secondary app-ask__quick-reply" data-module="govuk-button">{{ option }}</button>
      {% endfor %}
    </div>
    <div class="govuk-visually-hidden" aria-live="polite" role="status" data-ask-quick-status></div>
  </form>
  {% endif %}

  {% if answer.rule %}
  <blockquote class="app-ask__rule">
    <p class="app-ask__rule-label">Quoted from the guidance, word for word</p>
    <p class="app-ask__rule-text govuk-body">{{ answer.rule.text }}</p>
    <p class="app-ask__rule-source">
      From <a class="govuk-link" href="{{ answer.rule.source.url }}">{{ answer.rule.source.title }}</a>
    </p>
  </blockquote>
  {% endif %}

  {% if answer.sources | length %}
  <div class="app-ask__check">
    {# cannot_answer's sources are the nearest guidance found, not the
       guidance an answer used, since there isn't one. #}
    <h3 class="govuk-heading-s app-ask__check-heading">{{ "Nearest guidance" if answer.status == 'cannot_answer' else "Guidance used" }}</h3>
    {# Page titles only. The section came through as a subtitle like "What the
       conditions mean", which reads as a stray fragment next to a page name
       and told nobody anything. #}
    <ul class="govuk-list govuk-list--bullet app-ask__sources">
      {% for source in answer.sources %}
      <li>
        <a class="govuk-link" href="{{ source.url }}">{{ source.title }}</a>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  {# Last, under the guidance it used, so the warning is the final word before
     someone acts on the answer. Only where there is an answer to act on: a
     warning under "the toolkit cannot answer this" says nothing. #}
  {% if answer.status == 'answered' or answer.status == 'need_more_detail' %}
  {% include "partials/ask-warning.njk" %}
  {% endif %}

</div>
