{# The question field and its button. Shared by the front door and the
   conversation, so the two never drift apart. The only difference is the
   label, which changes once a conversation has started.

   There is deliberately no maxlength on the field. The server rejects anything
   over the limit with a specific error, whereas maxlength silently truncates
   pasted text, which is worse: someone would send a question with the end cut
   off and never know. If research shows people hit the limit, add the GOV.UK
   character count component rather than the attribute. #}
<form method="post" action="/ai-toolkit/ask" class="app-ask__panel">
  <div class="govuk-form-group{% if error %} govuk-form-group--error{% endif %}">
    <label class="govuk-label govuk-label--m" for="question">
      {{ questionLabel | default('Your question') }}
    </label>
    <div id="question-hint" class="govuk-hint">
      Do not include personal or sensitive information.
    </div>
    {% if error %}
    <p id="question-error" class="govuk-error-message">
      <span class="govuk-visually-hidden">Error:</span> {{ error }}
    </p>
    {% endif %}
    <div class="app-ask__row">
      <div class="app-ask__field">
        <textarea
          class="govuk-textarea app-ask__input{% if error %} govuk-textarea--error{% endif %}"
          id="question"
          name="question"
          rows="{{ questionRows }}"
          aria-describedby="question-hint{% if error %} question-error{% endif %}">{{ question or '' }}</textarea>
      </div>
      <button type="submit" class="govuk-button app-ask__send" data-module="govuk-button">
        Ask<span class="govuk-visually-hidden"> the toolkit</span>
      </button>
    </div>
  </div>
</form>
